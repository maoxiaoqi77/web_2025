# =====================================================
# Web-2025 优化配置 - Nginx服务器
# 
# 使用方法：
# 1. 复制到 /etc/nginx/sites-available/your-site
# 2. 修改 server_name 和 root 路径
# 3. 创建软链接: sudo ln -s /etc/nginx/sites-available/your-site /etc/nginx/sites-enabled/
# 4. 测试配置: sudo nginx -t
# 5. 重启Nginx: sudo systemctl restart nginx
# =====================================================

server {
    listen 80;
    listen [::]:80;
    server_name your-domain.com www.your-domain.com;
    
    # HTTP重定向到HTTPS (如果使用HTTPS)
    return 301 https://$server_name$request_uri;
}

server {
    # ===== 基本配置 =====
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name your-domain.com www.your-domain.com;
    
    root /var/www/web-2025;
    index index.html;
    
    # 字符集
    charset utf-8;
    
    # ===== SSL证书（使用Let's Encrypt） =====
    ssl_certificate /etc/letsencrypt/live/your-domain.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/your-domain.com/privkey.pem;
    
    # SSL优化配置
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers ECDHE-RSA-AES256-GCM-SHA512:DHE-RSA-AES256-GCM-SHA512:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES256-GCM-SHA384;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    
    # ===== Gzip压缩 =====
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types
        text/plain
        text/css
        text/xml
        text/javascript
        text/x-component
        application/json
        application/javascript
        application/x-javascript
        application/xml
        application/xml+rss
        application/rss+xml
        font/truetype
        font/opentype
        application/vnd.ms-fontobject
        image/svg+xml;
    gzip_disable "msie6";
    gzip_min_length 1000;
    
    # ===== Brotli压缩（需要安装brotli模块） =====
    # brotli on;
    # brotli_comp_level 6;
    # brotli_types text/plain text/css text/xml text/javascript application/json application/javascript application/xml+rss image/svg+xml;
    
    # ===== 安全Headers =====
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;
    
    # ===== 图片缓存（1年） =====
    location ~* \.(jpg|jpeg|png|gif|webp|ico|svg)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header Vary "Accept";
        access_log off;
        log_not_found off;
    }
    
    # ===== CSS/JS缓存（1年） =====
    location ~* \.(css|js)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }
    
    # ===== 字体缓存（1年 + CORS） =====
    location ~* \.(woff|woff2|ttf|otf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header Access-Control-Allow-Origin "*";
        access_log off;
    }
    
    # ===== 视频缓存（1年） =====
    location ~* \.(mp4|webm|ogg)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
        
        # MP4流媒体支持
        mp4;
        mp4_buffer_size 1m;
        mp4_max_buffer_size 5m;
    }
    
    # ===== HTML缓存（1小时） =====
    location ~* \.html$ {
        expires 1h;
        add_header Cache-Control "public, must-revalidate";
    }
    
    # ===== 根路径 =====
    location / {
        try_files $uri $uri/ /index.html;
        expires 1h;
        add_header Cache-Control "public, must-revalidate";
    }
    
    # ===== 响应式图片目录 =====
    location /_responsive/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }
    
    # ===== 禁止访问隐藏文件 =====
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
    
    # ===== 禁止访问特定文件 =====
    location ~* \.(log|md|txt|sh|sql|bak|swp)$ {
        deny all;
        access_log off;
        log_not_found off;
    }
    
    # ===== 日志 =====
    access_log /var/log/nginx/web-2025-access.log;
    error_log /var/log/nginx/web-2025-error.log warn;
    
    # ===== 客户端上传限制 =====
    client_max_body_size 20M;
    
    # ===== 性能优化 =====
    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    types_hash_max_size 2048;
}

# =====================================================
# 高级配置（可选）
# =====================================================

