# =====================================================
# Web-2025 优化配置 - Apache服务器
# 
# 功能：
# - Gzip压缩 (文件小70%)
# - 浏览器缓存 (速度快90%)
# - 安全headers
# =====================================================

# ------------------------------------------------------
# 1. Gzip压缩
# ------------------------------------------------------
<IfModule mod_deflate.c>
  # 压缩文本类型文件
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xml+rss
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/truetype
  AddOutputFilterByType DEFLATE font/opentype
  AddOutputFilterByType DEFLATE application/vnd.ms-fontobject
  
  # 排除已压缩的文件
  SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp|mp4|webm)$ no-gzip
</IfModule>

# ------------------------------------------------------
# 2. 浏览器缓存
# ------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  
  # 图片 - 1年
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  
  # CSS/JS - 1年
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  
  # 字体 - 1年
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType application/x-font-woff "access plus 1 year"
  ExpiresByType application/x-font-ttf "access plus 1 year"
  ExpiresByType application/x-font-otf "access plus 1 year"
  
  # 视频 - 1年
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType video/webm "access plus 1 year"
  ExpiresByType video/ogg "access plus 1 year"

  # HTML - 1小时 (方便更新)
  ExpiresByType text/html "access plus 1 hour"
</IfModule>

# Cache-Control headers
<IfModule mod_headers.c>
  # 图片 - immutable (永不改变)
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|ico|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  
  # CSS/JS - immutable
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  
  # 字体 - immutable + CORS
  <FilesMatch "\.(woff|woff2|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
  
  # 视频 - immutable
  <FilesMatch "\.(mp4|webm|ogg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  
  # HTML - 短缓存
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>

# ------------------------------------------------------
# 3. 安全Headers
# ------------------------------------------------------
<IfModule mod_headers.c>
  # 防止被iframe嵌入
  Header set X-Frame-Options "SAMEORIGIN"
  
  # 防止MIME类型嗅探
  Header set X-Content-Type-Options "nosniff"
  
  # XSS保护
  Header set X-XSS-Protection "1; mode=block"
  
  # Referrer策略
  Header set Referrer-Policy "no-referrer-when-downgrade"
  
  # 移除服务器版本信息
  Header unset X-Powered-By
  Header unset Server
</IfModule>

# ------------------------------------------------------
# 4. 图片优化
# ------------------------------------------------------
<IfModule mod_headers.c>
  # 图片添加vary header
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg)$">
    Header append Vary Accept
  </FilesMatch>
</IfModule>

# ------------------------------------------------------
# 5. 字体CORS
# ------------------------------------------------------
<IfModule mod_headers.c>
  <FilesMatch "\.(ttf|ttc|otf|eot|woff|woff2)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>

# ------------------------------------------------------
# 6. 错误页面
# ------------------------------------------------------
# ErrorDocument 404 /404.html
# ErrorDocument 500 /500.html

# ------------------------------------------------------
# 7. 禁止目录浏览
# ------------------------------------------------------
Options -Indexes

# ------------------------------------------------------
# 8. 字符集
# ------------------------------------------------------
AddDefaultCharset UTF-8

# ------------------------------------------------------
# 9. ETag
# ------------------------------------------------------
<IfModule mod_headers.c>
  Header unset ETag
</IfModule>
FileETag None

# ------------------------------------------------------
# 10. FollowSymLinks
# ------------------------------------------------------
Options +FollowSymLinks

# ------------------------------------------------------
# 11. Rewrite规则（如需SPA路由）
# ------------------------------------------------------
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteBase /
#   RewriteRule ^index\.html$ - [L]
#   RewriteCond %{REQUEST_FILENAME} !-f
#   RewriteCond %{REQUEST_FILENAME} !-d
#   RewriteRule . /index.html [L]
# </IfModule>

# =====================================================
# 配置完成！
# 
# 验证方法：
# 1. 检查Gzip: curl -H "Accept-Encoding: gzip" -I https://your-domain.com/css/style.css
# 2. 检查缓存: curl -I https://your-domain.com/images/photo.jpg
# 3. 在线测试: https://tools.keycdn.com/performance
# =====================================================
